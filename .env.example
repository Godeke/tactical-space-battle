# These are examples. The server reads process environment variables;
# it does not automatically load this file.
VECTOR_PORT=3100
VECTOR_HOST=127.0.0.1
VECTOR_ORIGIN=http://127.0.0.1:3100
# Set to enable standalone username/password accounts:
# VECTOR_AUTH_FILE=D:/vector-private/accounts.json
# VECTOR_DATA_DIR=D:/vector-private/games
# Required when serving HTTPS remotely:
# VECTOR_TLS_CERT=D:/vector-private/server.crt
# VECTOR_TLS_KEY=D:/vector-private/server.key
