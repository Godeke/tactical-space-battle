{
  "name": "tactical-space-battle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:browser": "node --test test/browser.mjs",
    "vector": "npm start",
    "check": "npm run build && npm run typecheck && npm test",
    "account:add": "node server/account-cli.ts"
  },
  "dependencies": {
    "three": "^0.180.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "fastify": "5.12.7",
    "@fastify/cookie": "11.1.3"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  },
  "description": "Vector Fleet: continuous 3D fleet tactics with physically grounded simulation",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=12.0.2"
  }
}
